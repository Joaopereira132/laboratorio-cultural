# Copia este ficheiro para ".env" e preenche os valores. NUNCA faças commit do ".env".

# Chave que assina as sessões e os tokens CSRF. Gera uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=muda-isto-para-um-valor-aleatorio

# Base de dados (cria um utilizador com permissões limitadas - ver README)
DB_HOST=localhost
DB_PORT=3306
DB_USER=lab_user
DB_PASSWORD=muda-isto
DB_NAME=lab_cultural

# 1 apenas quando servido por HTTPS (cookie de sessão só por ligação segura)
SESSION_COOKIE_SECURE=0

# 1 apenas em desenvolvimento local
FLASK_DEBUG=0
